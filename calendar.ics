---
layout: null
permalink: /calendar.ics
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Prostranstvo Evolyucii//Vstrechi s Masterom//RU
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Ретриты с Мастером · {{ site.data.site.year }}
{%- assign evs = site.events | sort: "start", "last" -%}
{%- for e in evs %}{% if e.start %}
BEGIN:VEVENT
UID:{{ e.slug }}@evolution-master
DTSTAMP:{{ site.time | date: "%Y%m%dT%H%M%SZ" }}
DTSTART;VALUE=DATE:{{ e.start | date: "%Y%m%d" }}
DTEND;VALUE=DATE:{{ e.end | date: "%s" | plus: 86400 | date: "%Y%m%d" }}
SUMMARY:{{ e.title }} · Ретриты с Мастером
LOCATION:{{ e.place | replace: ",", "\," }}
DESCRIPTION:{{ e.summary | replace: ",", "\," | replace: ";", "\;" }}
URL:{{ site.url }}{{ site.baseurl }}{{ e.url }}
END:VEVENT
{%- endif %}{% endfor %}
END:VCALENDAR
